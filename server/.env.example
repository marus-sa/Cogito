# Для локального запуска оставьте пустым: будет создана база server/data/cogito.db.
# На хостинге Render добавляет DATABASE_URL автоматически.
DATABASE_URL=

# Нужны только для первого запуска с FLASK_ENV=production.
# Не добавляйте эти значения в Git: в Render они задаются как секреты.
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
