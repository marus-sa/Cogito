# Первый администратор при запуске через Docker. Пароль — от 12 символов.
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Почтовое подтверждение регистрации. Не коммитьте реальные значения.
# Для Yandex/Mail.ru/Gmail нужен отдельный пароль приложения.
APP_URL=http://127.0.0.1:5000
SMTP_HOST=
# Для STARTTLS обычно 587; для SSL — 465 (SMTP_USE_SSL=1, SMTP_USE_TLS=0).
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Cogito — Light Hearts
SMTP_USE_TLS=1
SMTP_USE_SSL=0
