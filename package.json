{
  "name": "cogito-light-hearts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cd server && .venv/bin/python app.py",
    "start": "gunicorn --chdir server --bind 0.0.0.0:${PORT:-5000} app:app",
    "test:api": "cd server && .venv/bin/python test_api.py",
    "test:accounts": "cd server && .venv/bin/python test_accounts.py",
    "test:client": "node --test tests/*.test.js",
    "check": "npm run build && npm run test:client && npm run test:api && npm run test:accounts",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "lucide-vue-next": "latest",
    "pinia": "latest",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "vite": "latest"
  }
}
